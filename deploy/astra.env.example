# Template only. Install the real file as /etc/astra/astra.env, root:astra 0640.
# Values use systemd EnvironmentFile syntax, not shell commands.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=astra.example.invalid
DJANGO_BEHIND_PROXY=1
DJANGO_DATA_DIR=/var/lib/astra
DJANGO_STATIC_ROOT=/var/www/astra/static
DJANGO_AGREEMENT_STORAGE_ROOT=/var/lib/astra/agreements
DJANGO_AGREEMENT_COMPLETION_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=astra
DJANGO_DB_USER=astra
DJANGO_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_AGREEMENT_DOCKER_COMMAND=/usr/bin/docker
# Replace with the locally built immutable sha256 image ID. Never pull on upload.
DJANGO_AGREEMENT_DOCX_IMAGE=REPLACE_WITH_LOCAL_IMAGE_SHA256
# Optional to signing, required to enable the assistant; use a Free-plan key only.
GROQ_API_KEY=
